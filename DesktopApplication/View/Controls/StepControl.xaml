<UserControl x:Class="DesktopApplication.View.Controls.StepControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:c="clr-namespace:DesktopApplication.View.Controls"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="380">
    <Border Background="{DynamicResource Background2}" BorderBrush="{DynamicResource Background1}"
            CornerRadius="5" Margin="0, 5, 0, 5" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <StackPanel Background="Transparent" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Stretch" MouseLeftButtonDown="OnClick" Cursor="Hand">
                <TextBlock FontSize="14" Foreground="{DynamicResource Text}" 
                           FontWeight="Bold" x:Name="Number" VerticalAlignment="Center" HorizontalAlignment="Center">0</TextBlock>
            
                <TextBlock FontSize="18" VerticalAlignment="Center" Margin="10, 0, 0, 0"
                           FontWeight="Bold" TextWrapping="Wrap" x:Name="Title" Foreground="White">Strategy</TextBlock>
            </StackPanel>
            
            <Grid Grid.Row="1" Grid.Column="0" x:Name="BottomPart" Visibility="Collapsed" Margin="0, 5, 0, 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                    <RadioButton VerticalAlignment="Center" x:Name="BeforeButton" Style="{StaticResource StepRadioButton}" Checked="BeforeChecked">Before</RadioButton>
                    <RadioButton VerticalAlignment="Center" x:Name="AfterButton" Style="{StaticResource StepRadioButton}" Checked="AfterChecked">After</RadioButton>
                </StackPanel>
                
                <c:PageSelectorControl Grid.Row="0" Grid.Column="2" HorizontalAlignment="Left" x:Name="PageSelector"/>
                
                <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" x:Name="TextOutput" FontSize="15" HorizontalAlignment="Left"
                           Foreground="{DynamicResource Text}" TextWrapping="Wrap" Margin="0, 20, 0, 20"/>
                
                <Button Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource FullPrimaryButton}" Margin="0, 0, 0, 0" 
                        Padding="7" FontSize="16" HorizontalAlignment="Stretch" Click="OnExplanationAsked">Explanation</Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
